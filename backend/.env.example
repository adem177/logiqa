# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit your real .env file (it contains secrets).

# ----- MySQL -----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=logiqa
DB_PORT=3306

# ----- Flask API -----
PORT=3000
# Use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# ----- Default admin (created automatically by init_db.py) -----
ADMIN_EMAIL=admin@logiqa.local
ADMIN_PASSWORD=Admin123!
ADMIN_NOM=Admin
ADMIN_PRENOM=Logiqa
